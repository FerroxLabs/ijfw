{
  "name": "ijfw",
  "version": "1.5.5",
  "description": "IJFW -- AI efficiency layer for Gemini CLI. 19 workflow skills, 11-event hooks, persistent project memory via MCP. Native policy engine + checkpointing integration. One install layer across 15 AI coding platforms.",
  "contextFileName": "IJFW.md",
  "mcpServers": {
    "ijfw-memory": {
      "command": "node",
      "args": ["${IJFW_MCP_PATH:-${HOME}/.ijfw/mcp-server/src/server.js}"],
      "env": {
        "IJFW_PROJECT_DIR": "${PWD}",
        "PATH": "${PATH}"
      },
      "trust": true
    }
  },
  "excludeTools": [],
  "marketplace": {
    "author": "Ferrox Labs",
    "homepage": "https://github.com/FerroxLabs/ijfw",
    "license": "MIT",
    "category": "productivity",
    "keywords": ["workflow", "memory", "audit", "trident", "efficiency"],
    "min_gemini_version": "0.38.0"
  }
}
