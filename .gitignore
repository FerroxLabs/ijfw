# IJFW runtime state — per-install, not source.
.ijfw/
# Compute lever per-project FTS5 db (v1.3.0 alpha). Belt-and-braces: parent
# .ijfw/ already covers it, but explicit entry survives if someone narrows
# the parent rule later.
.ijfw/index/
# Profile-bus real-corpus eval scratch (Gate B/C). Contains derived prose slugs +
# raw result blobs — NEVER commit. Parent .ijfw/ already covers the repo-relative
# default; runs use a /tmp scratch outside the repo entirely. Explicit for clarity.
.ijfw/profile-eval-scratch/

# Disposable README-preview artifacts (regenerate any time via /tmp/readme-preview.mjs
# + scripts/render-*.mjs). NEVER commit — the full-page render is ~13MB.
/README-preview.html
docs/img/README-github-preview*.png

# v1.5.2 visible-layer (Plan A IJFW Brain).
#
# `ijfw/` at a project root is a real user-facing feature: it's where end
# users drop files into `ijfw/dump/inbox/` for the dream cycle to process,
# where the bi-temporal wiki materialises (`ijfw/wiki/<type>/<slug>.md`),
# and where teams commit shared brain context for cross-project search.
# End-user projects SHOULD commit `ijfw/` (per `ijfw_brain.wiki.shareReadme`
# instructions in the generated `ijfw/README.md`).
#
# In THIS repo (the IJFW source-of-truth), `ijfw/` is just a runtime artifact
# created whenever someone runs `mcp-server/src/server.js` as the MCP entry
# point with the repo as cwd — the framework consuming its own dogfood. It
# does NOT belong in the published package, because the package ships the
# framework, not anyone's particular brain. So we gitignore it HERE.
#
# This rule is repo-local; it does not propagate to user projects that
# install IJFW via npm. They get a fresh .gitignore that does not exclude
# `ijfw/`.
ijfw/

# v1.5.0 T20: truncation-recovery fixtures need committed target/.ijfw/
# state to seed the "moment of truncation" project root in CI. Without
# this negation the .ijfw/ rule above silently strips them from git, so
# linux CI clones a fixture corpus that's missing 25 state files and the
# per-fixture / rate / artifact tests fail with "(missing)" on the post-
# recovery state check. Negate just under the fixture path; leave every
# other .ijfw/ alone.
!mcp-server/fixtures/truncation-corpus/*/target/
!mcp-server/fixtures/truncation-corpus/*/target/.ijfw/
!mcp-server/fixtures/truncation-corpus/*/target/.ijfw/**

# GitLab CI per-job IJFW_HOME (set in .gitlab-ci.yml). Hermetic per-job
# state dir; never committed.
.ijfw-test/

# GitLab CI captured logs per pipeline (artifacts only; not source).
ci-logs/

# Derived: installer/docs/ is synced from /docs at build time
installer/docs/

# Vestigial installer template. Do not track.
.ijfw-gitignore

# Internal planning docs (per-project, not public).
.planning/

# NonCommercial benchmark transcripts (LoCoMo / ConvoMem, CC-BY-NC) — run
# INTERNALLY only, NEVER commit their content. Cell files carry question/gold
# text (= the dataset's copyrighted material). Only DERIVED metrics (accuracy,
# McNemar) may be reported, in a scrubbed internal doc. Data is fetched-not-bundled.
**/_private/

# The ENTIRE lab study lives in its OWN separate repo, never bundled with the
# product. It carries NonCommercial dataset transcripts (LoCoMo / LongMemEval)
# and infra notes (pod IPs, SSH key names) that must not ship in this public
# MIT repo. Moved out to a sibling dir (e.g. ../ijfw-lab-study). This rule keeps
# it from ever creeping back in.
lab-study/

# Internal superpowers planning / spec / audit docs (R&D notes, absolute dev
# paths). Moved out to a sibling dir. Never part of the published product.
docs/superpowers/

# Node
node_modules/
dist/
# installer/templates/ is staged by installer/scripts/build.js (Aider convention
# templates for the published tarball) -- build artifact, not source.
installer/templates/
*.log
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# install.sh leaks when run on IJFW's own repo (dogfood)
# install.sh now auto-refuses project-scoped writes when it detects the
# IJFW source tree (PWD matches REPO_ROOT). These gitignore entries are
# belt-and-braces in case anyone runs install.sh with the auto-detect
# disabled or from a sub-directory.
.cursor/
.codex/
.claude/
.windsurfrules
.github/copilot-instructions.md
mcp-server/.github/

# Local dev-tree guard (Sean only) -- prevents install.sh from targeting the
# IJFW source checkout itself. Must NOT be tracked or user clones will refuse
# to install. Recreate locally with: touch .ijfw-source
.ijfw-source

# wayland-parity local rollback registry
.ijfw/state/waves.json

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# npm pack artifacts
installer/*.tgz

# AGENTS.md merger backups (Phase 2 / A1) -- relocated to ~/.ijfw/state/agents-md/
# in v1.3.0 alpha, but belt-and-braces in case anyone runs an older merger.
AGENTS.md.bak.*
*.bak.*

# LongMemEval-S benchmark data (V2-M8 / D-PILLAR-SPEC §9). Harness lives
# in mcp-server/test/longmemeval-baseline.js (committed). Data is fetched
# on-demand from huggingface.co/datasets/xiaowu0162/longmemeval-cleaned.
mcp-server/test/fixtures/longmemeval-s/longmemeval_s_cleaned.json
mcp-server/test/fixtures/longmemeval-s/longmemeval_m_cleaned.json
mcp-server/test/fixtures/longmemeval-s/longmemeval_oracle.json

# v1.4.1 W8-A1 / B6 registry meta-key sentinel.
# Public PEM only; gitignored to prevent confusion with committed v1.x trust roots.
# The corresponding constant is inlined into mcp-server/src/extension-registry.js by W8-A1.
# Private key lives at ~/.ijfw/meta-keypair/<fp>.priv.pem (mode 0600).
mcp-server/src/.registry-meta-key.pem
.playwright-mcp/
